<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Nexa</AssemblyName>
    <RootNamespace>SessionDashboard</RootNamespace>
    <Product>Nexa</Product>
    <Title>nexa</Title>
    <Description>nexa — a space for whatever comes next</Description>
    <ApplicationIcon>assets\nexa-icon.ico</ApplicationIcon>
    <Version>0.0.31</Version>
    <AssemblyVersion>0.0.31.0</AssemblyVersion>
    <FileVersion>0.0.31.0</FileVersion>
    <InformationalVersion>$(Version)-alpha</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.DoNotScaleForDpiChanges" Value="false" />
    <Compile Remove="LEGACY\**\*.cs" /><Page Remove="LEGACY\**\*.xaml" /><ApplicationDefinition Remove="LEGACY\**\*.xaml" />
    <Compile Remove="verification\**\*.cs" /><Page Remove="verification\**\*.xaml" /><ApplicationDefinition Remove="verification\**\*.xaml" />
    <Compile Remove="Builds\**\*.cs" /><Page Remove="Builds\**\*.xaml" /><ApplicationDefinition Remove="Builds\**\*.xaml" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="test-output\**\*.cs" />
    <Page Remove="test-output\**\*.xaml" />
    <Compile Remove="obj\**\*.cs" />
    <EmbeddedResource Include="assets\Bible\*.json.gz" LogicalName="SessionDashboard.Bible.%(Filename)%(Extension)" />
    <Resource Include="assets\nexa-icon-seasonal.ico" /><Resource Include="assets\nexa-icon-seasonal-256.png" /><Resource Include="assets\nexa-logo-full-dark-seasonal.svg" />
    <Resource Include="assets\nexaween-pumpkin-030.png" />
    <Resource Include="assets\nexa-icon.ico" />
    <Resource Include="assets\nexa-icon-256.png" />
    <Resource Include="assets\add.png" />
    <Resource Include="assets\continue.png" />
    <Resource Include="assets\import.png" />
    <Resource Include="assets\nexa-logo-full-dark.svg" />
  </ItemGroup>

</Project>
